{
  "name": "@cap-js/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for AI-assisted development of CAP applications.",
  "homepage": "https://cap.cloud.sap/",
  "license": "Apache-2.0",
  "author": "SAP SE (https://www.sap.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cap-js/mcp-server.git"
  },
  "bin": {
    "cds-mcp": "index.js"
  },
  "files": [
    ".claude-plugin/",
    "lib/",
    ".mcp.json",
    "icon.png",
    "index.js",
    "manifest.json"
  ],
  "type": "module",
  "scripts": {
    "test": "node --experimental-test-module-mocks --test --test-concurrency=1",
    "lint": "npx eslint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "setup": "rm -rf node_modules package-lock.json && npm i"
  },
  "dependencies": {
    "@cap-js/ai": "^1.3.0",
    "@cap-js/sqlite": "^3.1.0",
    "@huggingface/hub": "^2.17.8",
    "@huggingface/tokenizers": "^0.2.0",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sap/cds": ">=10.1.0",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "oxfmt": ">=0.73.0"
  },
  "cds": {
    "log": {
      "levels": {
        "@cap-js/ai": "error"
      }
    }
  },
  "mcpName": "io.github.cap-js/mcp-server"
}
