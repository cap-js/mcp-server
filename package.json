{
  "name": "@cap-js/mcp-server",
  "mcpName": "io.github.cap-js/mcp-server",
  "version": "0.0.5",
  "description": "Model Context Protocol (MCP) server for AI-assisted development of CAP applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cap-js/mcp-server.git"
  },
  "author": "SAP SE (https://www.sap.com)",
  "homepage": "https://cap.cloud.sap/",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    ".claude-plugin/",
    "lib/",
    "embeddings/",
    ".mcp.json",
    "icon.png",
    "index.js",
    "manifest.json"
  ],
  "bin": {
    "cds-mcp": "./index.js"
  },
  "scripts": {
    "setup": "rm -r node_modules package-lock.json && npm i && rm -r node_modules/@cap-js/sqlite && node scripts/linkSqlite.mjs ",
    "test": "node --test --test-concurrency=1",
    "lint": "npx eslint .",
    "create-embeddings": "node scripts/createEmbeddings.js",
    "install-model": "node scripts/installModel.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sap/cds": ">=9",
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "@cap-js/ai": "git+https://github.com/cap-js/ai.git#prep-v1.2.0",
    "@cap-js/db-service": "git+https://github.com/cap-js/cds-dbs.git#use-ai-plugin",
    "@cap-js/sqlite": "^3.0.2",
    "@huggingface/hub": "^2.16.3",
    "@huggingface/tokenizers": "^0.1.3",
    "@huggingface/transformers": "^4.2.0",
    "cli-progress": "^3.12.0",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "onnxruntime-node": "1.20.1"
  }
}
