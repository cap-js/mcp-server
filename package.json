{
  "name": "@cap-js/mcp-server",
  "mcpName": "io.github.cap-js/mcp-server",
  "version": "0.0.5",
  "description": "Model Context Protocol (MCP) server for AI-assisted development of CAP applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cap-js/mcp-server.git"
  },
  "author": "SAP SE (https://www.sap.com)",
  "homepage": "https://cap.cloud.sap/",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    ".claude-plugin/",
    "lib/",
    ".mcp.json",
    "icon.png",
    "index.js",
    "manifest.json"
  ],
  "bin": {
    "cds-mcp": "./index.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "lint": "npx eslint .",
    "evals": "node -e \"import('./evals/lib/cli.js').then(m=>m.run()).then(r=>process.exit(r.code)).catch(e=>{console.error(e);process.exit(3)})\"",
    "evals:show": "node -e \"import('./evals/lib/show.js').then(m=>m.show({target:process.argv[1]})).then(r=>process.exit(r.code)).catch(e=>{console.error(e);process.exit(3)})\"",
    "evals:compare": "node -e \"import('./evals/lib/compare.js').then(m=>m.compare()).then(r=>process.exit(r.code)).catch(e=>{console.error(e);process.exit(3)})\"",
    "evals:test": "node --test --test-concurrency=1 evals/tests/unit/*.test.js",
    "evals:baseline": "node -e \"Promise.all([import('./evals/lib/config.js'),import('./evals/lib/store.js')]).then(([c,s])=>c.loadConfig().then(cfg=>s.promoteBaseline(cfg))).then(r=>console.log(r.promoted?('Promoted '+r.run_id+' -> '+r.baseline):'No runs to promote')).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sap/cds": ">=9",
    "onnxruntime-web": "^1.24.3"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "prettier": "^3.8.3"
  }
}
